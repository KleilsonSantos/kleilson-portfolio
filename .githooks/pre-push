#!/usr/bin/env bash
# Bloqueia push direto para branches protegidas.
# Bypass não recomendado; CI também aplica os gates de qualidade.

set -euo pipefail

_remote="${1:-}"
_url="${2:-}"
: "${_remote}" "${_url}"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [[ -z "${_local_ref:-}" ]] && continue
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/sandbox" ]]; then
    echo "pre-push: push direto para ${remote_ref#refs/heads/} é proibido."
    echo "pre-push: abra um PR. Merge: bash scripts/merge-pr.sh <n>"
    exit 1
  fi
done

echo "pre-push: ok!"
exit 0
